    [HttpGet("CasesTask")]
    public async Task<IActionResult> OnGetCasesTaskAsync()
    {
      try
      {
        GrupoDatoModel custom = new GrupoDatoModel();
        custom.GDTOS = "GDCASESTASK";
        var resultGD = await _consultasGrupoDato.ObtenerAll(custom);

        // VLR1 = 1, VLR2 = FECHA EJECUCION, VLR3 = CORRREOS DE USUARIOS A NOTIFICAR SEPARADO POR COMAS
        var resultGD_1 = resultGD.Where(x => x.VLR1 == "1");
        // ejecutar tareas de enviar correos PENDIENTES DCC
        if (resultGD_1 != null && resultGD_1.Any())
        {
          // validar si VLR2 esta en el dia indicado ... VENDRA DIA|HORA - VIERNES|15:30
          var fechaEjecucionParts = resultGD_1.FirstOrDefault()?.VLR2?.Split('|');
          if (fechaEjecucionParts != null && fechaEjecucionParts.Length == 2)
          {
            var diaEjecucion = fechaEjecucionParts[0].ToUpper(); // VIERNES
            var horaEjecucion = fechaEjecucionParts[1]; // 15:30

            // Obtener día actual en español
            var culturaEspanol = new CultureInfo("es-ES");
            var diaActual = culturaEspanol.DateTimeFormat.GetDayName(DateTime.Now.DayOfWeek).ToUpper(); // VIERNES
            var horaActual = DateTime.Now.ToString("HH:mm"); // OBTENER HORA

            if (diaEjecucion == diaActual && horaEjecucion == horaActual)
            {
              // Ejecutar la tarea
              CasosModel casosCustom = new CasosModel();
              casosCustom.GDACCNSCMRCLS = "3";
              casosCustom.INIT = 0;
              casosCustom.ROWS = 1000;
              casosCustom.IDEMPRSA = 1;

              var casosPendientes = await _consultasCasos.ListarCasos(casosCustom);

              // Enviar correos a los usuarios indicados en VLR3
              var correosUsuarios = resultGD_1.FirstOrDefault()?.VLR3?.Split(',');
              if (correosUsuarios != null && correosUsuarios.Length > 0)
              {
                // Limpiar espacios en blanco de los correos
                var correosLimpios = correosUsuarios.Select(c => c.Trim()).Where(c => !string.IsNullOrEmpty(c)).ToArray();
                
                // Generar el cuerpo del correo una sola vez
                string emailBody = GetEmailBodyCasosPendientesDCC(casosPendientes);
                
                // Enviar correo a todos los destinatarios
                await SendEmailAsync(emailBody, correosLimpios, $"Casos Pendientes Honorarios DCC - {casosPendientes.Count} caso(s)");
              }
              return new JsonResult(new { EsSatisfactoria = true, message = "Tarea ejecutada correctamente.", casosProcesados = casosPendientes.Count() });
            }
            else
            {
              return new JsonResult(new { EsSatisfactoria = false, message = "No es el momento de ejecución programado." });
            }
          }
        }

        return new JsonResult(new { EsSatisfactoria = false, message = "No hay tareas programadas para ejecutar." });
      }
      catch (Exception ex)
      {
        return StatusCode(500, "Error interno del servidor: " + ex.Message);
      }

    }

