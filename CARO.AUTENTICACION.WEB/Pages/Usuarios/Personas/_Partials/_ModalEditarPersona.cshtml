<div class="modal fade" id="modalEditPersona" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-simple modal-edit-user">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3>Editar Persona</h3>
                </div>
                <form id="EditPersona" class="row g-3" method="post">
                    <div class="col-12">
                        <div action="/upload" class="dropzone needsclick
                            d-flex justify-content-center align-items-center" id="dropzone-area">
                            <div class="dz-message needsclick">
                                Arrastra el archivo o haz clic para subir la plantilla
                                <span class="note needsclick">
                                    (Esta es sólo una visualización
                                    <span class="fw-medium">del</span> archivo.)
                                </span>
                            </div>
                            <div class="fallback">
                                <input name="file" name="ARCHVO" type="file" accept="image/*" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <h5 class="mb-4">Datos Personales</h5>
                        <hr />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="NOMBRS">P. Nombre <span class="text-danger">*</span></label>
                        <input type="text" id="NOMBRS" name="NOMBRS" class="form-control noMayus max-length" data-maxlength="100" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="SNOMBRS">S. Nombre </label>
                        <input type="text" id="SNOMBRS" name="SNOMBRS" class="form-control noMayus max-length" data-maxlength="100" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="APLLDS">P. Apellido <span class="text-danger">*</span></label>
                        <input type="text" id="APLLDS" name="APLLDS" class="form-control noMayus max-length" data-maxlength="100" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="SAPLLDS">S. Apellido</label>
                        <input type="text" id="SAPLLDS" name="SAPLLDS" class="form-control noMayus max-length" data-maxlength="100" />
                    </div>
        
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="DCUMNTO">Nro. Documento <span class="text-danger">*</span></label>
                        <input type="text" id="DCUMNTO" name="DCUMNTO" class="form-control noMayus max-length sin-espacios" data-maxlength="13" />
                    </div>
        
                    <div class="col-12">
                        <h5 class="mb-4">Datos de Contacto</h5>
                        <hr />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="CORREO">Correo <span class="text-danger">*</span></label>
                        <input type="text" id="CORREO" name="CORREO" class="form-control noMayus max-length sin-espacios" data-maxlength="100" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="TELFNO">Teléfono</label>
                        <input type="text" id="TELFNO" name="TELFNO" class="form-control max-length sin-espacios" data-maxlength="15" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="DEPARTAMENTO">Departamento</label>
                        <select id="DEPARTAMENTO" name="DEPARTAMENTO" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="PROVINCIA">Provincia</label>
                        <select id="PROVINCIA" name="PROVINCIA" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="DISTRITO">Distrito</label>
                        <select id="DISTRITO" name="DISTRITO" class="select2 form-select" data-allow-clear="true">
                        </select>   
                    </div>

                    <div class="col-12 col-md-9">
                        <label class="form-label" for="DIRECCION">Dirección</label>
                        <input type="text" id="DIRECCION" name="DIRECCION" class="noMayus form-control max-length" data-maxlength="200" />
                    </div>

                    <div class="col-12">
                        <h5 class="mb-4">Datos de Empresa</h5>
                        <hr />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="IDMRCA">Empresa <span class="text-danger">*</span></label>
                        <select id="IDMRCA" name="IDMRCA" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="CARGO">Cargo</label>
                        <input type="text" id="CARGO" name="CARGO" class="form-control noMayus max-length" data-maxlength="200" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="IDROL">Rol <span class="text-danger">*</span></label>
                        <select id="IDROL" name="IDROL" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="RESENA">Reseña</label>
                        <textarea id="RESENA" name="RESENA" class="form-control noMayus max-length" data-maxlength="500" rows="3"></textarea>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="PASSWORD">Contraseña (Solo si desea cambiar) <span class="text-danger">*</span></label>
                        <input type="password" id="PASSWORD" name="PASSWORD" class="form-control max-length sin-espacios" data-maxlength="100" />
                    </div>


                    <div class="col-12 col-md-4 d-flex flex-row align-items-center gap-3 ">
                        <label class="form-label" for="PRMSO">Usuario Activo?  </label>
                        <label class="switch switch-square">
                            <input type="checkbox" class="switch-input"
                                value="S" checked
                                id="PRMSO" name="PRMSO">
                            <span class="switch-toggle-slider">
                                <span class="switch-on"></span>
                                <span class="switch-off"></span>
                            </span>
                        </label>
                    </div>

                    <div class="col-12">
                        <h5 class="mb-4">Redes Sociales</h5>
                        <hr />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="GDREDSOCIAL">Red Social <span class="text-danger">*</span></label>
                        <select id="GDREDSOCIAL" name="GDREDSOCIAL" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label" for="ENLACE">Link <span class="text-danger">*</span></label>
                        <input type="text" id="ENLACE" name="ENLACE" class="form-control noMayus max-length sin-espacios" data-maxlength="200" />
                    </div>

                    <div class="col-12 col-md-2 d-flex flex-row align-items-end gap-3 ">
                        <button id="btnAddRedSocial" class="btn btn-icon btn-primary" type="button">
                            <span class="tf-icons bx bx-plus"></span>
                        </button>
                    </div>

                    <div class="col-12">
                        <div class="table-responsive text-nowrap">
                            <table class="table table-bordered" id="tblRedesSociales">
                                <thead>
                                    <tr class="text-center">
                                        <th>Red Social</th>
                                        <th>Link</th>
                                        <th>Acciones</th>
                                        <th class="d-none"></th>
                                    </tr>
                                </thead>
                                <tbody class="table-border-bottom-0">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button id="btnEditPersona" class="btn btn-primary me-sm-3 me-1">Guardar</button>
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    </div>

                    @await Html.PartialAsync("../../../_Partials/_AuditoriaE.cshtml")

                </form> 
            </div>
        </div>
    </div>
</div>