<div class="modal fade" id="modalEditEmpresa" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-simple modal-edit-user">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3>Editar Empresa</h3>
                </div>
                <form id="EditEmpresa" class="row g-3" method="post">
                    <div class="col-12">
                        <div action="/upload" class="dropzone needsclick
                            d-flex justify-content-center align-items-center" id="dropzone-area">
                            <div class="dz-message needsclick">
                                Arrastra el archivo o haz clic para subir la plantilla
                                <span class="note needsclick">
                                    (Esta es sólo una visualización
                                    <span class="fw-medium">del</span> archivo.)
                                </span>
                            </div>
                            <div class="fallback">
                                <input name="file" name="ARCHVO" type="file" accept="image/*" />
                            </div>
                        </div>
                    </div>


                    <div class="col-12">
                        <label class="form-label" for="MRCA">Nombre Comercial<span class="text-danger">*</span></label>
                        <input type="text" id="MRCA" name="MRCA" class="form-control max-length" data-maxlength="200" />
                    </div>


                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="RUC">RUC</label>
                        <input type="text" id="RUC" name="RUC" class="form-control max-length" data-maxlength="11" />
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="RZNSCIL">Razón Social</label>
                        <input type="text" id="RZNSCIL" name="RZNSCIL" class="form-control max-length" data-maxlength="200" />
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="IDPRSNA">Gerente</label>
                        <select id="IDPRSNA" name="IDPRSNA" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="IDPAIS">País</label>
                        <select id="IDPAIS" name="IDPAIS" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="PRVNCA">Provincia</label>
                        <input type="text" id="PRVNCA" name="PRVNCA" class="form-control max-length" data-maxlength="200" />
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="DRCNN">Dirección</label>
                        <input type="text" id="DRCNN" name="DRCNN" class="form-control max-length" data-maxlength="200" />
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="GDENTDD">Entidad Bancaria</label>
                        <select id="GDENTDD" name="GDENTDD" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="CCNTA">Cuenta</label>
                        <input type="text" id="CCNTA" name="CCNTA" class="form-control max-length" data-maxlength="200" />
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label class="form-label" for="CCNTACCI">Cuenta CCI</label>
                        <input type="text" id="CCNTACCI" name="CCNTACCI" class="form-control max-length" data-maxlength="200" />
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button id="btnEditEmpresa" class="btn btn-primary me-sm-3 me-1">Guardar</button>
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    </div>

                    @await Html.PartialAsync("../../../_Partials/_AuditoriaE.cshtml")

                </form> 
            </div>
        </div>
    </div>
</div>
