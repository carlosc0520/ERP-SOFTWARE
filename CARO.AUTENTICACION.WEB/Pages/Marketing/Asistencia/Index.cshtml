@page
@model CARO.AUTENTICACION.WEB.Pages.Marketing.Asistencia.IndexModel
@{
    ViewData["Title"] = "Asistencia";
}


@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/umd/styles/index.min.css" />
    <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/tagify/tagify.dist.css" />
     
} 

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/app-calendar.dist.css" />
} 

  
@section VendorScripts {
    <script src="~/vendor/libs/fullcalendar/fullcalendar.dist.js"></script>
    <script src="~/vendor/libs/block-ui/block-ui.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script> 
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/bundle/popular.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-bootstrap5/index.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-auto-focus/index.min.js"></script>
    <script src="~/vendor/libs/dropzone/dropzone.dist.js"></script>
    <script src="~/vendor/libs/tagify/tagify.dist.js"></script>

}

@section PageScripts {
    <script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="~/app/Marketing/Asistencia/index.js"></script>
}


@* ************** Content ************** *@   
<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Asistencia /</span> Cursos
</h4>


<div class="col-12">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-tabs nav-fill" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-cursos" aria-controls="navs-cursos" aria-selected="false">
                    <i class="tf-icons bx bx-user me-1"></i> Cursos
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-calendario" disabled="true" aria-controls="navs-calendario" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Calendario
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-asistencia" disabled="true" aria-controls="navs-asistencia" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Registro Horas 
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-participantes" disabled="true" aria-controls="navs-participantes" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Participantes
                </button>
            </li>
        </ul>
        <div class="tab-content p-0">
            <div class="tab-pane fade show active" id="navs-cursos" role="tabpanel">
                <div class="table-responsive pb-0">
                    <table id="cursosTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-calendario" role="tabpanel">
                <div class="table-responsive pb-0">
                    <div id="calendarioTable_title" class="card-header pb-2"></div>
                    <div class="card app-calendar-wrapper">
                        <div class="row g-0">
                            <!-- Calendar Sidebar -->
                            <div class="col app-calendar-sidebar" id="app-calendar-sidebar">
                                <div class="border-bottom p-4 my-sm-0 mb-3">
                                    <div class="d-grid">
            
                                    </div> 
                                </div>
                                <div class="p-4">
                                    <!-- inline calendar (flatpicker) -->
                                    <div class="ms-n2">
                                        <div class="inline-calendar"></div>
                                    </div>

                                    <hr class="container-m-nx my-4">
                                </div>
                            </div>
                            <!-- /Calendar Sidebar -->
                            <!-- Calendar & Modal -->
                            <div class="col app-calendar-content"> 
                                <div class="card shadow-none border-0">
                                    <div class="card-body pb-0">
                                        <!-- FullCalendar -->
                                        <div id="calendar"></div>
                                    </div>
                                </div>
                                <div class="app-overlay"></div> 
                                <!-- FullCalendar Offcanvas -->
                                <div class="offcanvas offcanvas-end event-sidebar" tabindex="-1" id="addEventSidebar" aria-labelledby="addEventSidebarLabel">
                                    <div class="offcanvas-header border-bottom">
                                        <h6 class="offcanvas-title" id="addEventSidebarLabel">Agregar Fecha</h6>
                                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                    </div>
                                    <div class="offcanvas-body">
                                        <form class="pt-0" id="AddCalendar" method="post">
                                            <div class="mb-3">  
                                                <label class="form-label" for="EVENTTITLE">Descripción <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="EVENTTITLE" name="EVENTTITLE" placeholder="" />
                                            </div> 
                                            <div class="mb-3">  
                                                <label class="form-label" for="EVENTSTARTDATE">Fecha - Hora Inicio <span class="text-danger">*</span></label>
                                                <input type="text" class="dob-picker-format-hour form-control" id="EVENTSTARTDATE" name="EVENTSTARTDATE" />
                                            </div> 
                                            <div class="mb-3">
                                                <label class="form-label" for="EVENTENDDATE">Fecha - Hora Fin <span class="text-danger">*</span></label>
                                                <input type="text" class="dob-picker-format-hour form-control" id="EVENTENDDATE" name="EVENTENDDATE" />
                                            </div> 
                                            <div class="mb-3 select2-primary">
                                                <label class="form-label" for="EVENTGUESTS">Profesores</label>
                                                <input  data-var="EVENTGUESTS" id="EVENTGUESTS" name="EVENTGUESTS" class="selects2-form form-control"  />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label" for="CESTDO">Estado</label>
                                                <select id="CESTDO" name="CESTDO" class="form-select no-reset" aria-label="Default select example">
                                                    <option value="A">Activo</option>
                                                    <option value="I">Inactivo</option>
                                                </select>
                                            </div>
                                            <div class="mb-3 d-flex justify-content-sm-between justify-content-start my-4">
                                                <div>
                                                    <button id="btnAddCalendar" class="btn btn-primary me-sm-3 me-1">Guardar</button>
                                                    <button id="btnDeleteCalendar" class="btn btn-danger me-sm-0 me-1" >Eliminar</button>
                                                </div>
                                            </div>
                                            <div class="mb-3 d-flex justify-content-sm-between justify-content-start my-4">
                                                <div>
                                                     <button id="btnRegisterCalendar" class="btn btn-info me-sm-0 me-1" >Ver horas</button>
                                                </div>
                                            </div>


                                        </form> 
                                    </div>
                                </div>
                            </div>
                            <!-- /Calendar & Modal -->
                        </div>
                    </div>
                </div>
            </div> 
            <div class="p-2 tab-pane fade" id="navs-asistencia" role="tabpanel">
                <div id="reader" 
                class="d-none"
                style="width:300px; height:300px; background-color: lightgray; position: absolute; cursor: move;"></div>

                <div class="table-responsive pb-0">
                    <div id="asistenciaTable_title" class="card-header pb-2"></div>
                    <table id="asistenciaTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-participantes" role="tabpanel">
                <div class="table-responsive pb-0">
                    <div id="participantesTable_title" class="card-header pb-2"></div>
                    <table id="participantesTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("./_Partials/_ModalAgregarParticipante")
@await Html.PartialAsync("./_Partials/_ModalEditarParticipante")
@await Html.PartialAsync("./_Partials/_ModalEditarConfiguracion")
@await Html.PartialAsync("./_Partials/_ModalAgregarDetSubModulo")
@await Html.PartialAsync("./_Partials/_ModalAgregarSubModulo")
@await Html.PartialAsync("./_Partials/_ModalEditarDetSubModulo")
@await Html.PartialAsync("./_Partials/_ModalEditarSubModulo")
@await Html.PartialAsync("./_Partials/_ModalAsistenciaParticipante")


