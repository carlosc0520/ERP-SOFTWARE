<div class="modal fade" id="modalEditConfiguracion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-simple modal-edit-user">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3>Editar Configuración</h3>
                </div>
                <form id="EditConfiguracion" class="row g-3" method="post">
                    <div class="col-12">
                        <div action="/upload" class="dropzone needsclick
                            d-flex justify-content-center align-items-center" id="dropzone-area">
                            <div class="dz-message needsclick">
                                Arrastra el archivo o haz clic para subir la plantilla
                                <span class="note needsclick">
                                    (Esta es sólo una visualización
                                    <span class="fw-medium">del</span> archivo.)
                                </span>
                            </div>
                            <div class="fallback">
                                <input name="file" name="ARCHVO" type="file" accept="image/*" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label" for="EJEX">NOMBRES - Eje X <span class="text-danger">*</span></label>
                        <input type="text" id="EJEX" name="EJEX" class="form-control solo-decimales" maxlength="18" required>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label" for="EJEY">NOMBRES - Eje Y <span class="text-danger">*</span></label>
                        <input type="text" id="EJEY" name="EJEY" class="form-control solo-decimales" maxlength="18" required>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label" for="EJEX2">QR - Eje X <span class="text-danger">*</span></label>
                        <input type="text" id="EJEX2" name="EJEX2" class="form-control solo-decimales" maxlength="18" required>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label" for="EJEY2">QR - Eje Y <span class="text-danger">*</span></label>
                        <input type="text" id="EJEY2" name="EJEY2" class="form-control solo-decimales" maxlength="18" required>
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button id="btnEditConfiguracion" class="btn btn-primary me-sm-3 me-1">Guardar</button>
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    </div>

                    @await Html.PartialAsync("../../../_Partials/_AuditoriaE.cshtml")

                </form> 
            </div>
        </div>
    </div>
</div>
