<!-- Nueva UI -->
<div class="profile-banner"></div>

  <div class="container profile-card">
    <div class="row align-items-center">
      <!-- avatar -->
      <div class="col-md-3 d-flex align-items-center">
        <div class="avatar-wrap">
          <img id="IMG_PERFIL" src="https://via.placeholder.com/160" alt="avatar">
        </div>
      </div>

      <div class="col-md-5 container-profile">
        <div class="d-flex align-items-center gap-3">
          <h2 class="mb-0" style="font-weight:800; font-size:24px;" id="NOMBRES_PERFIL"></h2>
        </div>
        <div class="mt-2 list-group list-group-flush">
            <div class="list-group-item d-flex align-items-center border-0 px-0 py-0">
                <i class="bi bi-briefcase text-secondary me-2 fs-5"></i>
                <span class="fw-bold text-dark">Cargo:</span>
                <span class="ms-2 text-muted" id="CARGO_PERFIL"></span>
            </div>
            <div class="list-group-item cursor-pointer d-flex align-items-center border-0 px-0 py-0">
                <i class="bi bi-envelope text-secondary me-2 fs-5"></i>
                <span class="fw-bold text-dark">Correo:</span>
                <a class="ms-2 text-muted" id="CORREO_PERFIL"></a>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-2">
          <button class="btn btn-follow">GUARDAR</button>
          <button class="btn btn-outline-secondary btn-contact">ENVIAR</button>
        </div>
      </div>

      <div class="col-md-4 mt-3 mt-md-0">
        <div class="row text-end mb-3">
          <div class="col-4">
            <div class="stat-number">985</div>
            <div class="stat-label">Followers</div>
          </div>
          <div class="col-4">
            <div class="stat-number">132</div>
            <div class="stat-label">Following</div>
          </div>
          <div class="col-4">
            <div class="stat-number">548</div>
            <div class="stat-label">Likes</div>
          </div>
        </div>

        <div class="d-flex justify-content-end align-items-center">
          <button class="btn-contact btn btn-dark small-badge"><i class="bi bi-tiktok"></i></button>
          <button class="btn-contact btn btn-instagram small-badge"><i class="bi bi-instagram"></i></button>
          <button class="btn-contact btn btn-linkedin small-badge"><i class="bi bi-linkedin"></i></button>
          <button class="btn-contact btn btn-success small-badge"><i class="bi bi-whatsapp"></i></button>
        </div>
      </div>
    </div>

    <!-- nav -->
    <div class="row profile-nav">
      <div class="col-12">
        <ul class="nav" id="profileTabs" role="tablist" style="gap: 2rem !important">
          <li class="nav-item"><button class="nav-link" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal">Personal</button></li>
          <li class="nav-item"><button class="nav-link" id="company-tab" data-bs-toggle="tab" data-bs-target="#company">Empresa</button></li>
          <li class="nav-item"><button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact">Contacto</button></li>
          <li class="nav-item"><button class="nav-link active" id="qr-tab" data-bs-toggle="tab" data-bs-target="#qr">Mi QR</button></li>
        </ul>

        <!-- Contenido tabs -->
        <div class="tab-content mt-3">
            <div class="tab-pane fade" id="personal">
                <table class="table table-borderless">
                    <tr>
                        <td><strong>Nombre y Apellido</strong></td>
                        <td>Dino Carlos Caro Coria</td>
                    </tr>
                    <tr>
                        <td><strong>Cargo o Posición</strong></td>
                        <td>CEO en Caro & Asociados</td>
                    </tr>
                    <tr>
                        <td><strong>Reseña Personal</strong></td>
                        <td>CEO en Caro & Asociados. Doctor en Derecho por la Universidad de Salamanca/España. Derecho Penal y Compliance</td>
                    </tr>
                </table>
            </div>
            <div class="tab-pane fade" id="company">
                <table class="table table-borderless">
                    <tr>
                        <td><strong>Nombre de la Empresa</strong></td>
                        <td>Caro & Asociados</td>
                    </tr>
                    <tr>
                        <td><strong>Web de la empresa</strong></td>
                        <td>ccfirma.com</td>
                    </tr>
                </table>
            </div>
            <div class="tab-pane fade" id="contact">
                <table class="table table-borderless">
                    <tr>
                        <td><strong>Correo</strong></td>
                        <td>ccaro@ccfirma.com</td>
                    </tr>
                    <tr>
                        <td><strong>Ciudad</strong></td>
                        <td>Lima</td>
                    </tr>
                    <tr>
                        <td><strong>País</strong></td>
                        <td>Perú</td>
                    </tr>
                    <tr>
                        <td><strong>Dirección</strong></td>
                        <td>Avenida Víctor Andrés Belaunde 370, San Isidro Lima</td>
                    </tr>
                </table>
            </div>
            <div class="tab-pane fade show active" id="qr">
                <div class="qr-code text-center">
                    <img id="QR_CODE" src="" alt="QR Code">
                    <p class="mt-2">Escanea para ver el perfil</p>
                </div>
            </div>
         </div>
      </div>
    </div>
  </div>
