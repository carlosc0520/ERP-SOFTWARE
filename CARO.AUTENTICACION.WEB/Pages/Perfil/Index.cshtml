<style>
    /* Colores base */
    :root {
        --primary-orange: #ff7b00;
        --light-gray: #f7f7f7;
        --text-gray: #555;
    }

    body {
        background-color: var(--light-gray);
        font-family: 'Segoe UI', sans-serif;
    }

    /* Perfil */
    .cover {
        background: linear-gradient(135deg, var(--primary-orange), #ffa94d);
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

    .cover:hover {
        transform: scale(1.03);
    }

    /* .profile-pic {
        max-width: 110px;
        border: 4px solid white;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease;
    }

    .profile-pic:hover {
        transform: scale(1.08) rotate(2deg);
    } */

    /* Botones */
    .btn-custom {
        font-weight: 500;
        border-radius: 25px;
        padding: 0.5rem 1.2rem;
        transition: all 0.3s ease;
    }

    .btn-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    /* Tabs */
    .nav-tabs .nav-link {
        font-weight: 500;
        color: var(--text-gray);
        border: none;
        padding: 0.6rem 1.2rem;
        transition: color 0.3s ease, background 0.3s ease;
        background-color: transparent !important;
    }

    .nav-tabs .nav-link.active {
        border-bottom: 5px solid var(--primary-orange) ;
    }

    .nav-tabs .nav-link.active:focus{
        border-bottom: 5px solid var(--primary-orange) ;
    }

    .nav-tabs .nav-link:hover {
        border-radius: 0 !important;
    }

    /* Tablas */
    .table td {
        padding: 0.6rem;
        vertical-align: middle;
    }

    /* Redes Sociales */
    .social-links img {
        width: 40px;
        margin: 5px;
        transition: transform 0.3s ease;
    }

    .social-links img:hover {
        transform: scale(1.2);
    }

    /* QR */
    .qr-code img {
        max-width: 180px;
        margin: 10px 0;
        transition: transform 0.3s ease;
    }

    .qr-code img:hover {
        transform: rotate(3deg) scale(1.05);
    }



    .badge {
        display: inline-block;
        padding: .25em .4em;
        font-size: 75%;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        vertical-align: baseline;
        border-radius: .25rem;
        color: #FFF;
        background-color: #365779
    }


    :root{ --accent:#6b63ff; --muted:#6c6c6c; }
    body{ font-family: 'Poppins', sans-serif; background:#fff; color:#222; }

    /* gradient banner */
    .profile-banner{
      height:120px;
      background: linear-gradient(90deg, rgba(107,99,255,0.22) 0%, rgba(246,187,255,0.22) 100%);
      border-radius:0 0 14px 14px;
    }

    .profile-card{
      margin-top:-48px; /* lift over the banner */
      background:transparent;
    }

    /* css de nuevo diseño */
    .avatar-wrap{
      width:100%;
      max-width: 200px!important;
      margin: auto;
      height:200px !important;
      overflow:hidden;
      border-radius:38px;
      box-shadow:0 10px 30px rgba(19,24,47,0.06);
      border:6px solid rgba(255,255,255,0.85);
    }
    .avatar-wrap img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .pro-badge{
      background:linear-gradient(90deg,#4b79ff,#8b66ff);
      color:#fff;
      font-weight:600;
      font-size:13px;
      padding:6px 8px;
      border-radius:8px;
      display:inline-flex;
      align-items:center; gap:6px;
    }

    .btn-follow{
      background:#111;
      color:#fff;
      border-radius:10px;
      padding:7px 18px;
      border:0;
      box-shadow:none;
    }
    .btn-contact{
      border-radius:10px;
      padding:7px 18px;
    }

    .stat-number{
      font-weight:800;
      font-size:36px;
    }

    .stat-label{
      color:var(--muted);
      font-size:14px;
    }

    /* circular small badges on top-right */
    .small-badge{
      width:40px;
      height:40px;
      border-radius:50%;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-weight:700;
      font-size:14px;
      margin-left:8px;
      box-shadow:0 6px 18px rgba(16,24,40,0.06);
    }
    .small-badge.orange{
      background:#ff7a00;
    }
    .small-badge.blue{
      background:#6b63ff;
    }
    .small-badge.dark{
      background:#111;
    }

    /* bottom nav */
    .profile-nav{ border-top:1px solid rgba(0,0,0,0.06); margin-top:22px; padding-top:18px; }
    .profile-nav .nav-link{ color:#333; font-weight:600; padding:8px 0; }
    .profile-nav .nav-link.active{ border-bottom:2px solid var(--accent); color:var(--accent); }
</style>

