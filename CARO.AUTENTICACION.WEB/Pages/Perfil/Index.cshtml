@page
@model CARO.AUTENTICACION.WEB.Pages.Perfil.IndexModel
@{
    ViewData["Title"] = "Perfil - Caro Asociados";
    Layout = "Layouts/_BlankLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/umd/styles/index.min.css" />
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.dist.css">
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/perfil-custom.css" />
}

@section VendorScripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/bundle/popular.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-bootstrap5/index.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-auto-focus/index.min.js"></script>
    <script src="~/vendor/libs/dropzone/dropzone.dist.js"></script>
    <script src="~/vendor/libs/select2/select2.dist.js"></script>
}

@section PageScripts {
    <script src="~/app/Perfil/index.js"></script>
}

<div class="spinner-container-imagen" id="spinner-container-imagen">
  <div class="spinner-modern">
    <div class="spinner-ring">
      <div></div>
      <div></div>
      <div></div>
    </div>
    <img src="https://ccfirma.com/wp-content/uploads/2026/01/logo-2024-4-1-1.png" alt="Logo" class="spinner-logo">
  </div>
  <p class="spinner-text">Cargando perfil...</p>
</div>



<div class="container profile-card d-none">
  <div class="row align-items-center">
    <!-- Avatar & Logo -->
    <div class="col-md-3 text-center">
      <div class="position-relative d-inline-block">
        <div class="avatar-wrap">
          <img id="IMG_PERFIL" src="https://placehold.co/180x180" alt="avatar">
        </div>
        <div class="custom-logo-container">
          <img class="w-100" id="IMG_PERFIL_EMP" src="https://placehold.co/64x64" alt="company logo">
        </div>
      </div>
    </div>

    <!-- Info Principal -->
    <div class="col-md-6 container-profile mt-4 mt-md-0">
      <h2 class="mb-3" id="NOMBRES_PERFIL"></h2>
      
      <div class="info-grid">
        <div class="info-item">
          <i class="bi bi-building"></i>
          <div class="info-content">
            <span class="info-label">Empresa</span>
            <span class="info-value" id="EMPRESA_PERFIL"></span>
          </div>
        </div>
        
        <div class="info-item">
          <i class="bi bi-briefcase"></i>
          <div class="info-content">
            <span class="info-label">Cargo</span>
            <span class="info-value" id="CARGO_PERFIL"></span>
          </div>
        </div>
        
        <div class="info-item">
          <i class="bi bi-envelope"></i>
          <div class="info-content">
            <span class="info-label">Correo</span>
            <a class="info-value" id="CORREO_PERFIL"></a>
          </div>
        </div>
      </div>

      <button class="btn mt-3" id="btnAddContacto">
        <i class="bi bi-person-plus-fill me-2"></i>Guardar Contacto
      </button>
    </div>

    <!-- Redes Sociales -->
    <div class="col-md-3 mt-4 mt-md-0">
      <div class="d-flex justify-content-center justify-content-md-end" id="redes-sociales">
      </div>
    </div>
  </div>

  <!-- nav -->
  <div class="row profile-nav">
    <div class="col-12">
      <ul class="nav" id="profileTabs" role="tablist" style="gap: 2rem !important">
        <li class="nav-item"><button class="nav-link" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal">Personal</button></li>
        <li class="nav-item"><button class="nav-link" id="company-tab" data-bs-toggle="tab" data-bs-target="#company">Empresa</button></li>
        <li class="nav-item"><button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact">Contacto</button></li>
        <li class="nav-item"><button class="nav-link active" id="qr-tab" data-bs-toggle="tab" data-bs-target="#qr">Mi QR</button></li>
      </ul>

      <!-- Contenido tabs -->
      <div class="tab-content mt-3">
          <div class="tab-pane fade" id="personal">
              <table class="table table-borderless">
                  <tr>
                      <td class="poppins-bold"><strong>Nombre y Apellido</strong></td>
                      <td class="poppins-medium" id="NOMBRES_PERFIL_T1"></td>
                  </tr>
                  <tr>
                      <td class="poppins-bold"><strong>Cargo o Posición</strong></td>
                      <td class="poppins-medium" id="CARGO_PERFIL_T1"></td>
                  </tr>
                  <tr>
                      <td class="poppins-bold"><strong>Reseña Personal</strong></td>
                      <td class="poppins-medium" id="RESENA_PERFIL_T1"></td>
                  </tr>
              </table>
          </div>
          <div class="tab-pane fade" id="company">
              <table class="table table-borderless">
                  <tr>
                      <td class="poppins-bold"><strong>Nombre de la Empresa</strong></td>
                      <td class="poppins-medium" ID="EMPRESA_T2"></td>
                  </tr>
                  <tr>
                      <td class="poppins-bold"><strong>Web de la empresa</strong></td>
                      <td class="poppins-medium">
                        <a id="WEB_EMPRESA_T2" href="" target="_blank"></a>
                      </td>
                  </tr>
              </table>
          </div>
          <div class="tab-pane fade" id="contact">
              <table class="table table-borderless">
                  <tr>
                      <td class="poppins-bold"><strong>Correo</strong></td>
                      <td class="poppins-medium">
                        <a id="CORREO_PERFIL_T3" href="" target="_blank"></a>
                      </td>
                  </tr>
                  <tr>
                      <td class="poppins-bold"><strong>Teléfono</strong></td>
                      <td class="poppins-medium"><a id="TELEFONO_PERFIL_T3" href="" target="_blank"></a></td>
                  </tr>
                  <tr>
                      <td class="poppins-bold"><strong>País</strong></td>
                      <td class="poppins-medium">Perú</td>
                  </tr>
                  <tr>
                      <td class="poppins-bold"><strong>Ciudad</strong></td>
                      <td class="poppins-medium"
                      id="CIUDAD_PERFIL_T3"
                      ></td>
                  </tr>
                  <tr>
                      <td class="poppins-bold"><strong>Dirección</strong></td>
                      <td class="poppins-medium"
                      id="DIRECCION_PERFIL_T3"
                      ></td>
                  </tr>
              </table>
          </div>
          <div class="tab-pane fade show active" id="qr">
              <div class="qr-code text-center">
                  <img id="QR_CODE" src="" alt="QR Code">
                  <p class="mt-2">Escanea para ver el perfil</p>
              </div>
          </div>
        </div>
    </div>
  </div>
</div>
