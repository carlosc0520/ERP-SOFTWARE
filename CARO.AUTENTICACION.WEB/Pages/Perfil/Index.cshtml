    .profile-card{
      margin-top:-48px; /* lift over the banner */
      background:transparent;
    }

    /* css de nuevo diseño */
    .avatar-wrap{
      width:100%;
      max-width: 200px!important;
      margin: auto;
      height:200px !important;
      overflow:hidden;
      border-radius:38px;
      background-color: #FFF;
      box-shadow:0 10px 30px rgba(19,24,47,0.06);
      border:6px solid rgba(255,255,255,0.85);
      z-index: 100;
    }
    .avatar-wrap img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .pro-badge{
      background:linear-gradient(90deg,#4b79ff,#8b66ff);
      color:#fff;
      font-weight:600;
      font-size:13px;
      padding:6px 8px;
      border-radius:8px;
      display:inline-flex;
      align-items:center; gap:6px;
    }

    .btn-follow{
      background:#111;
      color:#fff;
      border-radius:10px;
      padding:7px 18px;
      border:0;
      box-shadow:none;
    }
    .btn-contact{
      border-radius:10px;
      padding:7px 18px;
    }

    .btn-linkedin {
      background-color: #007bff !important;
      border-color: #007bff !important;
    }

    .btn-linkedin:hover {
      background-color: #007bff !important;
    }

    .stat-number{
      font-weight:800;
      font-size:36px;
    }

    .stat-label{
      color:var(--muted);
      font-size:14px;
    }

    /* circular small badges on top-right */
    .small-badge{
      width:40px;
      height:40px;
      border-radius:50%;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-weight:700;
      font-size:14px;
      margin-left:8px;
      box-shadow:0 6px 18px rgba(16,24,40,0.06);
    }

    .container-xxl{
        max-width:100% !important;
        margin: 0px;
        padding: 0px;
    }

    .content-wrapper .container-p-y:not([class^=pt-]):not([class*=" pt-"]){
