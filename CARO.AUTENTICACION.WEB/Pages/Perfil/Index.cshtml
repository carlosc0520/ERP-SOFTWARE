    /* Colores base */
    :root {
        --primary-orange: #ff7b00;
        --light-gray: #f7f7f7;
        --text-gray: #555;
        font-family: "Poppins" !important;
    }

    body {
        background-color: var(--light-gray);
        font-family: 'Segoe UI', sans-serif;
    }

    /* Perfil */
    .cover {
        background: linear-gradient(135deg, var(--primary-orange), #ffa94d);
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

    .cover:hover {
        transform: scale(1.03);
    }

    /* Botones */
    .btn-custom {
        font-weight: 500;
        border-radius: 25px;
        padding: 0.5rem 1.2rem;
        transition: all 0.3s ease;
    }

    .btn-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    /* Tabs */
    .nav-tabs .nav-link {
        font-weight: 500;
        color: var(--text-gray);
        border: none;
        padding: 0.6rem 1.2rem;
        transition: color 0.3s ease, background 0.3s ease;
        background-color: transparent !important;
    }

    .nav-tabs .nav-link.active {
        border-bottom: 5px solid var(--primary-orange) ;
    }

    .nav-tabs .nav-link.active:focus{
        border-bottom: 5px solid var(--primary-orange) ;
    }

    .nav-tabs .nav-link:hover {
        border-radius: 0 !important;
    }

    /* Tablas */
    .table td {
        padding: 0.6rem;
        vertical-align: middle;
    }

    /* Redes Sociales */
    .social-links img {
        width: 40px;
        margin: 5px;
        transition: transform 0.3s ease;
    }

    .social-links img:hover {
        transform: scale(1.2);
    }

    /* QR */
    .qr-code img {
        max-width: 180px;
        margin: 10px 0;
        transition: transform 0.3s ease;
    }

    .qr-code img:hover {
        transform: rotate(3deg) scale(1.05);
    }



    .badge {
        display: inline-block;
        padding: .25em .4em;
        font-size: 75%;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        vertical-align: baseline;
        border-radius: .25rem;
        color: #FFF;
        background-color: #365779
    }


    :root{ --accent:#ED6A23 ; --muted:#6c6c6c; }
    body{ font-family: 'Poppins', sans-serif; background:#fff; color:#222; }

    /* gradient banner */
    .profile-banner{
      position: relative;
      height: 150px;
      /* background-color: #FFF; */
      background:
      conic-gradient(from -60deg at 50% calc(100%/3),#ed6a23 0 120deg,#0000 0),
      conic-gradient(from 120deg at 50% calc(200%/3),#ed6a23 0 120deg,#0000 0),
      conic-gradient(from  60deg at calc(200%/3),#ed6a23 60deg,#9d400d 0 120deg,#0000 0),
      conic-gradient(from 180deg at calc(100%/3),#3f1905 60deg,#ed6a23 0 120deg,#0000 0),
      linear-gradient(90deg,#3f1905 calc(100%/6),#9d400d 0 50%,
      #3f1905 0 calc(500%/6), #9d400d 0);
      background-size: 346px 200px;
    }

    .profile-card{
      margin-top:-48px; 
      background:transparent;
    }

    .avatar-wrap{
      width:100%;
      max-width: 200px!important;
      margin: auto;
      height:200px !important;
      overflow:hidden;
      border-radius:38px;
      background-color: #FFF;
      box-shadow:0 10px 30px rgba(19,24,47,0.06);
      border:6px solid rgba(255,255,255,0.85);
      z-index: 100;
    }
    .avatar-wrap img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .pro-badge{
      background:linear-gradient(90deg,#4b79ff,#8b66ff);
      color:#fff;
      font-weight:600;
      font-size:13px;
      padding:6px 8px;
      border-radius:8px;
      display:inline-flex;
      align-items:center; gap:6px;
    }

    .btn-follow{
      background:#111;
      color:#fff;
      border-radius:10px;
      padding:7px 18px;
      border:0;
      box-shadow:none;
    }

    .btn-follow:hover{
      background:#111;
      color:#fff;
      box-shadow:0 6px 18px rgba(16,24,40,0.06);
    }


    .btn-contact{
      border-radius:10px;
      padding:7px 18px;
    }


    .stat-number{
      font-weight:800;
      font-size:36px;
    }

    .stat-label{
      color:var(--muted);
      font-size:14px;
    }

    .small-badge{
      width:40px;
      height:40px;
      border-radius:50%;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-weight:700;
      font-size:14px;
      margin-left:8px;
      box-shadow:0 6px 18px rgba(16,24,40,0.06);
    }

    .container-xxl{
        max-width:100% !important;
        margin: 0px;
        padding: 0px;
    }

    .content-wrapper .container-p-y:not([class^=pt-]):not([class*=" pt-"]){
        padding-top: 0px!important;
    }

    .profile-nav{ border-top:1px solid rgba(0,0,0,0.06); margin-top:22px; padding-top:18px; }
    .profile-nav .nav-link{ color:#333; font-weight:600; padding:5px 10px; }
    .profile-nav .nav-link.active{ 
        border-bottom: 2px solid #c9c9c9;
        color: white!important;
        background: #ff803ad6;
        border-radius: 5px;
    }

    .nav .nav-link:focus {
        color: #fff !important;
    }

    .profile-card a {
      color: #677788!important;
      text-decoration: none;
    }

    /* TikTok */
