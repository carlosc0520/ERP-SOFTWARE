@page
@model CARO.AUTENTICACION.WEB.Pages.Comercial.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
}


@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/umd/styles/index.min.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/tagify/tagify.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/typography.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/katex.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/editor.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/app-calendar.dist.css" />
}


@section VendorScripts {
    <script src="~/vendor/libs/block-ui/block-ui.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/bundle/popular.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-bootstrap5/index.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-auto-focus/index.min.js"></script>
    <script src="~/vendor/libs/dropzone/dropzone.dist.js"></script>
    <script src="~/vendor/libs/quill/katex.dist.js"></script>
    <script src="~/vendor/libs/quill/quill.dist.js"></script>
    <script src="~/vendor/libs/tagify/tagify.dist.js"></script>
    <script src="~/vendor/libs/select2/select2.dist.js"></script>
    <script src="~/vendor/libs/chartjs/chartjs.dist.js"></script>
}

@section PageScripts {
    <script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="~/app/Comercial/Clientes/index.js"></script>
    <!-- <script src="~/js/charts-chartjs.dist.js"></script> -->
}


@* ************** Content ************** *@
<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Clientes /</span> Listado
</h4>


<div class="col-12">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-tabs nav-fill" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-clientes" aria-controls="navs-clientes" aria-selected="false">
                    <i class="tf-icons bx bx-user me-1"></i> Cliente
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-seguimiento" disabled="true" aria-controls="navs-seguimiento" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Seguimiento
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-reporte" aria-controls="navs-reporte" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Reporte
                </button>
            </li>
        </ul>
        <div class="tab-content p-0">
            <div class="tab-pane fade show active" id="navs-clientes" role="tabpanel">
                <div class="table-responsive pb-0">
                    <table id="clientesTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-seguimiento" role="tabpanel">
                <div class="table-responsive pb-0">
                    <div id="seguimientoTable_title" class="card-header pb-2"></div>
                    <table id="seguimientoTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-reporte" role="tabpanel">
                <div class="row gy-4 p-3">
                    <form id="FormReporte" class="row g-3" method="post">
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold" for="FechaInicio">Marca</label>
                            <select id="IDMRCA" name="IDMRCA" class="select2 form-select" data-allow-clear="true">
                            </select>
                        </div>
                    </form>

                    <!-- Horizontal Bar Charts -->
                    <div class="col-xl-6 col-12 mt-4">
                        <div class="card-header header-elements">
                            <h5 class="card-title mb-0">Cumplidos</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="horizontalBarChart" class="chartjs" data-height="400"></canvas>
                        </div>
                    </div>
                    <!-- /Horizontal Bar Charts -->

                    <!-- Polar Area Chart -->
                    <div class="col-lg-6 col-12">
                        <div class="card-header header-elements">
                            <h5 class="card-title mb-0">Cumplidos</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="polarChart" class="chartjs" data-height="337"></canvas>
                        </div>
                    </div>
                    <!-- /Polar Area Chart -->

                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("./_Partials/_ModalAgregarCliente")
@await Html.PartialAsync("./_Partials/_ModalEditarCliente")
@await Html.PartialAsync("./_Partials/_ModalAgregarClienteSeguimiento")
@await Html.PartialAsync("./_Partials/_ModalEditarClienteSeguimiento")
