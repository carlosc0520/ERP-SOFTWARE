<div class="modal fade" id="modalEditFormulario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-simple modal-edit-user">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3>Editar Formulario</h3>
                </div>
                <form id="EditFormulario" class="row g-3" method="post">
                    <div class="col-12">
                        <label class="form-label" for="NOMBRE">Nombres <span class="text-danger">*</span></label>
                        <input type="text" id="NOMBRE" name="NOMBRE" class="form-control noMayus max-length" data-maxlength="500" />
                    </div>
                     
                    <div class="col-12 mb-3">
                        <label class="form-label" for="DESCP">Detalle </label>
                        <div id="editor-DESCP">
                            
                        </div>
                    </div>
                  
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="FINICIO">Fcha. Inicio </label>
                        <div class="input-group">
                            <input type="text" id="FINICIO" name="FINICIO" placeholder="DD-MM-YYYY" class="form-control date-mask dob-picker-format" />
                            <span class="input-group-text">
                                <i class="bi bi-calendar"></i>
                            </span>
                        </div>
                    </div>
 
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="FFIN">Fcha. Fin </label>
                        <div class="input-group">
                            <input type="text" id="FFIN" name="FFIN" placeholder="DD-MM-YYYY" class="form-control date-mask dob-picker-format" />
                            <span class="input-group-text">
                                <i class="bi bi-calendar"></i>
                            </span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="dropzone-area">Logo Formulario</label>
                        <div action="/upload" class="dropzone needsclick
                            d-flex justify-content-center align-items-center" id="dropzone-area">
                            <div class="dz-message needsclick">
                                Arrastra la imagen aquí o haz clic para subir.
                                <span class="note needsclick">(Esta es sólo una visualización
                                    <span class="fw-medium">de la</span> imagen.)</span>
                            </div>
                            <div class="fallback">
                                <input name="LOGO" type="file" accept="image/*" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="row">
                            <div class="classic col-12 col-md-6">
                                <p>Color de Fondo</p>
                                <div id="BGCOLOR"></div>
                            </div>
                            <div class="monolith col-12 col-md-6">
                                <p>Color Bordes</p>
                                <div id="BGCOLOR2"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="GDFORMT">Formulario Abierto</label>
                        <select id="GDFORMT" name="GDFORMT" class="form-select noMayus">
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="GDTPOGR">Tipo de Diseño <span class="text-danger">*</span></label>
                        <select id="GDTPOGR" name="GDTPOGR" class="form-select noMayus">
                            <option value="1">Lista</option>
                            <option value="2">Tarjeta</option>
                        </select>
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button id="btnEditFormulario" class="btn btn-primary me-sm-3 me-1">Guardar</button>
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    </div>

                    @await Html.PartialAsync("../../../../_Partials/_AuditoriaE.cshtml")

                </form> 
            </div>
        </div>
    </div>
</div>
