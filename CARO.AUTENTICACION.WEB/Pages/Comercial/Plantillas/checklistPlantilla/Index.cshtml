@* ************** Content ************** *@
<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Formularios /</span> Listado
</h4>



<div class="col-12">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-tabs nav-fill" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-formulario" aria-controls="navs-formulario" aria-selected="false">
                    <i class="tf-icons bx bx-user me-1"></i> Formularios
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-preguntas" disabled="true" aria-controls="navs-preguntas" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Preguntas
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-usuarios" disabled="true" aria-controls="navs-usuarios" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Usuarios
                </button>
            </li>
        </ul>
        <div class="tab-content p-0">
            <div class="tab-pane fade show active" id="navs-formulario" role="tabpanel">
                <div class="table-responsive pb-0">
                    <table id="formularioTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-preguntas" role="tabpanel">
                <div class="table-responsive pb-0">
                    <div id="preguntasTable_title" class="card-header pb-2"></div>
                    <table id="preguntasTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-usuarios" role="tabpanel">
                <div class="table-responsive pb-0">
                    <div id="usuariosTable_title" class="card-header pb-2"></div>
                    <table id="usuariosTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("./_Partials/_ModalAgregarFormulario")
@await Html.PartialAsync("./_Partials/_ModalEditarFormulario")
@await Html.PartialAsync("./_Partials/_ModalAgregarPregunta")
@await Html.PartialAsync("./_Partials/_ModalEditarPregunta")

