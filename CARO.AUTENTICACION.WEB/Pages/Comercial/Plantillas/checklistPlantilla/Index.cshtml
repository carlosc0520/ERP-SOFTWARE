<link rel="stylesheet" href="~/vendor/css/pages/app-email.dist.css" />
<link rel="stylesheet" href="~/css/erp-custom.css" asp-append-version="true" />

@* ************** Content ************** *@
<div class="erp-main-container erp-bg-main">
    <ul class="erp-tabs" role="tablist" style="overflow-x:unset;">
        <li>
            <button type="button" class="erp-tab active" role="tab" data-bs-toggle="tab"
                    data-bs-target="#navs-formulario" aria-controls="navs-formulario" aria-selected="true">
                <i class="tf-icons bx bx-list-check me-2"></i> Formularios
            </button>
        </li>
        <li>
            <button type="button" class="erp-tab" role="tab" data-bs-toggle="tab"
                    data-bs-target="#navs-preguntas" disabled="true" aria-controls="navs-preguntas" aria-selected="false">
                <i class="tf-icons bx bx-help-circle me-2"></i> Preguntas
            </button>
        </li>
        <li>
            <button type="button" class="erp-tab" role="tab" data-bs-toggle="tab"
                    data-bs-target="#navs-respuestas" disabled="true" aria-controls="navs-respuestas" aria-selected="false">
                <i class="tf-icons bx bx-comment-detail me-2"></i> Respuestas
            </button>
        </li>
    </ul>
    <div class="tab-content p-0">
        <div class="tab-pane fade show active" id="navs-formulario" role="tabpanel">
            <div class="table-responsive pb-0 px-4">
                <table id="formularioTable" class="mx-1 table border-top">
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="navs-preguntas" role="tabpanel">
            <div class="table-responsive pb-0 px-4">
                <div id="preguntasTable_title" class="card-header pb-2"></div>
                <table id="preguntasTable" class="mx-1 table border-top">
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="navs-respuestas" role="tabpanel">
            <div class="table-responsive pb-0 px-4">
                <div id="respuestasTable_title" class="card-header pb-2"></div>
                <table id="respuestasTable" class="mx-1 table border-top">
                </table>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("./_Partials/_ModalAgregarFormulario")
@await Html.PartialAsync("./_Partials/_ModalEditarFormulario")
@await Html.PartialAsync("./_Partials/_ModalAgregarPregunta")
@await Html.PartialAsync("./_Partials/_ModalEditarPregunta")

