@section PageScripts {
    <script src="~/app/CanalDenuncias/Configuracion/index.js"></script>
}

<link rel="stylesheet" href="~/vendor/css/pages/app-email.dist.css" />
<link rel="stylesheet" href="~/css/erp-custom.css" asp-append-version="true" />

@* ************** Content ************** *@
<div class="erp-main-container erp-bg-main">
    <ul class="erp-tabs" role="tablist" style="overflow-x:unset;">
        <li>
            <button type="button" class="erp-tab active" role="tab" data-bs-toggle="tab"
                    data-bs-target="#navs-tipodenuncia" aria-controls="navs-tipodenuncia" aria-selected="true">
                <i class="tf-icons bx bx-user me-2"></i> Tipo Denuncia
            </button>
        </li>
        <li>
            <button type="button" class="erp-tab" role="tab" data-bs-toggle="tab"
                    data-bs-target="#navs-relacionempresa" aria-controls="navs-relacionempresa" aria-selected="false">
                <i class="tf-icons bx bx-building me-2"></i> Relación con Empresa
            </button>
        </li>
        <li>
            <button type="button" class="erp-tab" role="tab" data-bs-toggle="tab"
                    data-bs-target="#navs-receptores" aria-controls="navs-receptores" aria-selected="false">
                <i class="tf-icons bx bx-mail-send me-2"></i> Receptores
            </button>
        </li>
    </ul>
    <div class="tab-content p-0">
        <div class="tab-pane fade show active" id="navs-tipodenuncia" role="tabpanel">
            <div class="table-responsive pb-0 px-4">
                <table id="tipodenunciaTable" class="mx-1 table border-top">
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="navs-relacionempresa" role="tabpanel">
            <div class="table-responsive pb-0 px-4">
                <table id="relacionempresaTable" class="mx-1 table border-top">
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="navs-receptores" role="tabpanel">
            <div class="table-responsive pb-0 px-4">
                <table id="receptoresTable" class="mx-1 table border-top">
                </table>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("./_Partials/_ModalAgregarReceptor")
@await Html.PartialAsync("./_Partials/_ModalAgregarRelacionEmpresa")
@await Html.PartialAsync("./_Partials/_ModalAgregarTipoDenuncia")
@await Html.PartialAsync("./_Partials/_ModalEditarReceptor")
@await Html.PartialAsync("./_Partials/_ModalEditarRelacionEmpresa")
@await Html.PartialAsync("./_Partials/_ModalEditarTipoDenuncia")
