@page
@model CARO.AUTENTICACION.WEB.Pages.CanalDenuncias.Configuracion.IndexModel
@{
    ViewData["Title"] = "Configuración Canal Denuncias";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/umd/styles/index.min.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/tagify/tagify.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/typography.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/katex.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/editor.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
}


@section VendorScripts {
    <script src="~/vendor/libs/block-ui/block-ui.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/bundle/popular.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-bootstrap5/index.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-auto-focus/index.min.js"></script>
    <script src="~/vendor/libs/dropzone/dropzone.dist.js"></script>
    <script src="~/vendor/libs/quill/katex.dist.js"></script>
    <script src="~/vendor/libs/quill/quill.dist.js"></script>
    <script src="~/vendor/libs/tagify/tagify.dist.js"></script>
    <script src="~/vendor/libs/select2/select2.dist.js"></script>
}

@section PageScripts {
    <script src="~/app/CanalDenuncias/Configuracion/index.js"></script>
}


@* ************** Content ************** *@
<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Configuración /</span> Canal de Denuncias
</h4>


<div class="col-12">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-tabs nav-fill" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-tipodenuncia" aria-controls="navs-tipodenuncia" aria-selected="false">
                    <i class="tf-icons bx bx-user me-1"></i> Tipo Denuncia
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-relacionempresa" aria-controls="navs-relacionempresa" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Relación con Empresa
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-receptores" aria-controls="navs-receptores" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Receptores
                </button>
            </li>
        </ul>
        <div class="tab-content p-0">
            <div class="tab-pane fade show active" id="navs-tipodenuncia" role="tabpanel">
                <div class="table-responsive pb-0">
                    <table id="tipodenunciaTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-relacionempresa" role="tabpanel">
                <div class="table-responsive pb-0">
                    <table id="relacionempresaTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-receptores" role="tabpanel">
                <div class="table-responsive pb-0">
                    <table id="receptoresTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("./_Partials/_ModalAgregarReceptor")
@await Html.PartialAsync("./_Partials/_ModalAgregarRelacionEmpresa")
@await Html.PartialAsync("./_Partials/_ModalAgregarTipoDenuncia")
@await Html.PartialAsync("./_Partials/_ModalEditarReceptor")
@await Html.PartialAsync("./_Partials/_ModalEditarRelacionEmpresa")
@await Html.PartialAsync("./_Partials/_ModalEditarTipoDenuncia")
