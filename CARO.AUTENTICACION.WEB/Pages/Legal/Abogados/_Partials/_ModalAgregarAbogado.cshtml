<div class="modal fade" id="modalAddAbogado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-simple modal-edit-user">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3>Agregar Abogado</h3>
                </div>
                <form id="AddAbogado" class="row g-3" method="post">
                    <div class="col-12 mb-3">
                        <label class="form-label" for="IDPRSNA">Persona <span class="text-danger">*</span></label>
                        <select id="IDPRSNA" name="IDPRSNA" class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-md-6 col-12 mb-3">
                        <label class="form-label" for="NCLGTRA">N° Colegiatura</label>
                        <input type="text" id="NCLGTRA" name="NCLGTRA" class="form-control max-length" data-maxlength="11" />
                    </div>

                    <div class="col-md-6 col-12 mb-3">
                        <label class="form-label" for="NLICNCIA">N° Licencia</label>
                        <input type="text" id="NLICNCIA" name="NLICNCIA" class="form-control max-length" data-maxlength="200" />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label" for="GDESPCLDD">Especialidad</label>
                        <select id="GDESPCLDD" name="GDESPCLDD" multiple class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label" for="GDSCRSLS">Sucursales</label>
                        <select id="GDSCRSLS" name="GDSCRSLS" multiple class="select2 form-select" data-allow-clear="true">
                        </select>
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button id="btnAddAbogado" class="btn btn-primary me-sm-3 me-1">Agregar</button>
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    </div>

                    @await Html.PartialAsync("../../../_Partials/_Auditoria.cshtml")
                     
                </form>
            </div>
        </div>
    </div>
</div>
