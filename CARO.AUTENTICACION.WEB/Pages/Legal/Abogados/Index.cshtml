@page
@model CARO.AUTENTICACION.WEB.wwwroot.app.Legal.Abogados.IndexModel
@{
    ViewData["Title"] = "Abogados";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/umd/styles/index.min.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.dist.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/block-ui/block-ui.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/bundle/popular.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-bootstrap5/index.min.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/umd/plugin-auto-focus/index.min.js"></script>
    <script src="~/vendor/libs/fullcalendar/fullcalendar.dist.js"></script>

}


@section PageScripts {
    <script src="~/app/Legal/Abogados/index.js"></script>
}


@* ************** Content ************** *@
<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Abogados /</span> Listado
</h4>


<div class="col-12">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-tabs nav-fill" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-abogados" aria-controls="navs-abogados" aria-selected="false">
                    <i class="tf-icons bx bx-user me-1"></i> Abogados
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                        data-bs-target="#navs-horarios" disabled="true" aria-controls="navs-horarios" aria-selected="false">
                    <i class="tf-icons bx bx-plus me-1"></i> Horarios
                </button>
            </li>
        </ul>
        <div class="tab-content p-0">
            <div class="tab-pane fade show active" id="navs-abogados" role="tabpanel">
                <div class="table-responsive pb-0">
                    <table id="abogadosTable" class="mx-1 table border-top">
                    </table>
                </div>
            </div>
            <div class="p-2 tab-pane fade" id="navs-horarios" role="tabpanel">
                <div class="table-responsive pb-0">
                    <div id="calendarioTable_title" class="card-header"></div>
                    <div class="card app-calendar-wrapper">
                        <div class="row g-0">
                            <!-- Calendar Sidebar -->
                        
                            <!-- /Calendar Sidebar -->
                            <!-- Calendar & Modal -->
                            <div class="col app-calendar-content">
                                <div class="card shadow-none border-0">
                                    <div class="card-body pb-0">
                                        <!-- FullCalendar -->
                                        <div id="calendar"></div>
                                    </div>
                                </div>
                                <div class="app-overlay"></div>
                                <!-- FullCalendar Offcanvas -->
                                <div class="offcanvas offcanvas-end event-sidebar" tabindex="-1" id="addEventSidebar" aria-labelledby="addEventSidebarLabel">
                                    <div class="offcanvas-header border-bottom">
                                        <h6 class="offcanvas-title" id="addEventSidebarLabel">Agregar Fecha</h6>
                                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                    </div>
                                    <div class="offcanvas-body">
                                        <form class="pt-0" id="AddCalendar" method="post">
                                            <div class="mb-3">
                                                <label class="form-label" for="FCHA">Fecha <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <input disabled type="text" id="FCHA" name="FCHA" placeholder="DD-MM-YYYY" class="form-control date-mask dob-picker-format" />
                                                    <span class="input-group-text">
                                                        <i class="bi bi-calendar"></i>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label for="flatpickr-time" for="HRAINIT" class="form-label">Hora desde</label>
                                                <input type="text" id="HRAINIT" name="HRAINIT" class="form-control flatpickr-timeout" placeholder="HH:MM"/>
                                            </div>

                                            <div class="mb-3">
                                                <label for="flatpickr-time" for="HRAFN" class="form-label">Hora Hasta</label>
                                                <input type="text" id="HRAFN" name="HRAFN" class="form-control flatpickr-timeout" placeholder="HH:MM"/>
                                            </div>

                                            <div class="mb-3 d-flex justify-content-sm-between justify-content-start my-4">
                                                <div>
                                                    <button id="btnAddCalendar" class="btn btn-primary me-sm-3 me-1">Guardar</button>
                                                    <button id="btnDeleteCalendar" class="btn btn-danger me-sm-0 me-1">Eliminar</button>
                                                </div>
                                            </div>
                                        </form>

                                    </div>
                                </div>
                            </div>
                            <!-- /Calendar & Modal -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@await Html.PartialAsync("./_Partials/_ModalAgregarAbogado")
@await Html.PartialAsync("./_Partials/_ModalEditarAbogado") 
